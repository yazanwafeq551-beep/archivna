generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                 String   @id @default(uuid())
  name_ar            String
  name_en            String?
  slug               String   @unique
  institution_type   String?
  registration_number String?
  description_ar     String?
  description_en     String?
  logo_path          String?
  contact_person     String?
  email              String?
  phone              String?
  website            String?
  address            String?
  city               String?
  created_by         String?
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  users            User[]
  archival_units   ArchivalUnit[]
  archive_records  ArchiveRecord[]
  role_assignments RoleAssignment[]
  access_requests  AccessRequest[]
}

model User {
  id                 String         @id @default(uuid())
  full_name          String
  email              String         @unique
  password_hash      String
  phone              String?
  institution_name   String?
  avatar_path        String?
  avatar_url         String?
  bio                String?
  preferred_language String         @default("ar")
  theme              String         @default("system")
  text_size          String         @default("normal")
  reduced_motion     Boolean        @default(false)
  account_status     String         @default("active")
  account_type       String         @default("individual")
  institution_id     String?
  password_reset_token        String?
  password_reset_expires_at   DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @default(now()) @updatedAt
  last_login_at      DateTime?

  refresh_tokens  RefreshToken[]
  archive_records ArchiveRecord[]
  favorites       Favorite[]
  notifications   Notification[]
  app_settings    AppSetting?
  audit_logs      AuditLog[]
  archive_files   ArchiveFile[]
  role_assignments         RoleAssignment[]      @relation("AssignedRoles")
  role_assignments_created RoleAssignment[]      @relation("RoleAssigner")
  access_requests          AccessRequest[]        @relation("AccessRequester")
  access_decisions         AccessRequest[]        @relation("AccessDecisionMaker")
  workflow_events          ArchiveWorkflowEvent[]

  course_enrollments CourseEnrollment[]
  lesson_progress    LessonProgress[]
  user_achievements  UserAchievement[]
  course_reviews     CourseReview[]
  saved_courses      SavedCourse[]

  institution Institution? @relation(fields: [institution_id], references: [id], onDelete: SetNull)
}

model RefreshToken {
  id             String    @id @default(uuid())
  user_id        String
  token          String    @unique
  expires_at     DateTime
  created_at     DateTime  @default(now())
  is_revoked     Boolean   @default(false)
  revoked_at     DateTime?
  /// rotated | logout | password_change | reuse_detected
  revoked_reason String?
  replaced_by_id String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model ArchiveRecord {
  id                   String         @id @default(uuid())
  owner_id             String
  institution_id       String?
  archival_unit_id     String?
  title_ar             String
  title_en             String?
  alternative_title_ar String?
  alternative_title_en String?
  reference_number     String?
  description_ar       String?
  description_en       String?
  creator_name         String?
  institution_name     String?
  collection_name      String?
  subject_text         String?
  place                String?
  language             String?
  material_type        String
  date_text            String?
  date_from            DateTime?
  date_to              DateTime?
  rights_statement     String?
  access_level         String         @default("public")
  status               String         @default("draft")
  ocr_status           String         @default("not_started")
  ocr_text_ar          String?
  ocr_text_en          String?
  metadata             Json?
  technical_metadata   Json?
  submitted_at         DateTime?
  reviewed_at          DateTime?
  reviewed_by          String?
  approved_at          DateTime?
  approved_by          String?
  published_at         DateTime?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @default(now()) @updatedAt

  owner     User              @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  institution Institution?    @relation(fields: [institution_id], references: [id], onDelete: SetNull)
  archival_unit ArchivalUnit? @relation(fields: [archival_unit_id], references: [id], onDelete: SetNull)
  files     ArchiveFile[]
  subjects  ArchiveSubject[]
  favorites Favorite[]
  access_policy AccessPolicy?
  access_requests AccessRequest[]
  workflow_events ArchiveWorkflowEvent[]
  agents ArchiveAgent[]
  controlled_terms ArchiveRecordTerm[]

  @@index([institution_id, status])
  @@index([archival_unit_id])
  @@index([access_level, status])
}

/// A node in the archival hierarchy. ArchiveRecord represents the final item level.
model ArchivalUnit {
  id             String   @id @default(uuid())
  institution_id String
  parent_id      String?
  level          String
  title_ar       String
  title_en       String?
  reference_code String?
  description_ar String?
  description_en String?
  sort_order     Int      @default(0)
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  institution Institution    @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  parent      ArchivalUnit?   @relation("ArchivalUnitTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children    ArchivalUnit[]  @relation("ArchivalUnitTree")
  records     ArchiveRecord[]

  @@index([institution_id, level])
  @@index([parent_id, sort_order])
}

model RoleAssignment {
  id             String   @id @default(uuid())
  user_id        String
  role           String
  institution_id String?
  assigned_by_id String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  user         User         @relation("AssignedRoles", fields: [user_id], references: [id], onDelete: Cascade)
  assigned_by  User?        @relation("RoleAssigner", fields: [assigned_by_id], references: [id], onDelete: SetNull)
  institution Institution?  @relation(fields: [institution_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role, institution_id])
  @@index([institution_id, role])
}

model AccessPolicy {
  id                  String   @id @default(uuid())
  archive_record_id   String   @unique
  access_level        String   @default("public")
  metadata_visibility String   @default("public")
  requires_reason     Boolean  @default(false)
  watermark_enabled   Boolean  @default(false)
  default_grant_hours Int      @default(72)
  sovereign_region    String?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  archive_record ArchiveRecord @relation(fields: [archive_record_id], references: [id], onDelete: Cascade)
}

model AccessRequest {
  id                String    @id @default(uuid())
  archive_record_id String
  requester_id      String
  institution_id    String?
  reason            String
  intended_use      String?
  status            String    @default("pending")
  decision_note     String?
  decided_by_id     String?
  decided_at        DateTime?
  expires_at        DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  archive_record ArchiveRecord @relation(fields: [archive_record_id], references: [id], onDelete: Cascade)
  requester      User          @relation("AccessRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  decided_by     User?         @relation("AccessDecisionMaker", fields: [decided_by_id], references: [id], onDelete: SetNull)
  institution    Institution?  @relation(fields: [institution_id], references: [id], onDelete: SetNull)

  @@index([requester_id, status])
  @@index([institution_id, status])
  @@index([archive_record_id, status])
}

model ArchiveWorkflowEvent {
  id                String   @id @default(uuid())
  archive_record_id String
  actor_id          String?
  from_status       String?
  to_status         String
  note              String?
  created_at        DateTime @default(now())

  archive_record ArchiveRecord @relation(fields: [archive_record_id], references: [id], onDelete: Cascade)
  actor          User?         @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([archive_record_id, created_at])
}

model Agent {
  id                  String   @id @default(uuid())
  name_ar             String
  name_en             String?
  agent_type          String
  authority_reference String?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  archive_records ArchiveAgent[]
}

model ArchiveAgent {
  archive_record_id String
  agent_id          String
  role              String

  archive_record ArchiveRecord @relation(fields: [archive_record_id], references: [id], onDelete: Cascade)
  agent          Agent         @relation(fields: [agent_id], references: [id], onDelete: Cascade)

  @@id([archive_record_id, agent_id, role])
}

model ControlledTerm {
  id          String   @id @default(uuid())
  scheme      String
  label_ar    String
  label_en    String?
  code        String?
  broader_id  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  broader  ControlledTerm?  @relation("ControlledTermTree", fields: [broader_id], references: [id], onDelete: SetNull)
  narrower ControlledTerm[]  @relation("ControlledTermTree")
  records  ArchiveRecordTerm[]

  @@index([scheme, label_ar])
}

model ArchiveRecordTerm {
  archive_record_id String
  term_id           String

  archive_record ArchiveRecord @relation(fields: [archive_record_id], references: [id], onDelete: Cascade)
  term           ControlledTerm @relation(fields: [term_id], references: [id], onDelete: Cascade)

  @@id([archive_record_id, term_id])
}

model ArchiveFile {
  id                String   @id @default(uuid())
  archive_record_id String
  owner_id          String
  storage_path      String
  secure_url        String?
  public_id         String?
  resource_type     String?
  original_filename String
  stored_filename   String
  file_extension    String
  file_type         String
  mime_type         String
  file_size         Int
  checksum          String
  thumbnail_path    String?
  duration_seconds  Int?
  page_count        Int?
  created_at        DateTime @default(now())

  archive_record ArchiveRecord @relation(fields: [archive_record_id], references: [id], onDelete: Cascade)
  owner          User          @relation(fields: [owner_id], references: [id], onDelete: Cascade)
}

model ArchiveSubject {
  id                String @id @default(uuid())
  archive_record_id String
  subject           String

  archive_record ArchiveRecord @relation(fields: [archive_record_id], references: [id], onDelete: Cascade)
}

model Favorite {
  id                String   @id @default(uuid())
  user_id           String
  archive_record_id String
  created_at        DateTime @default(now())

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  archive_record ArchiveRecord @relation(fields: [archive_record_id], references: [id], onDelete: Cascade)

  @@unique([user_id, archive_record_id])
}

model NewsCategory {
  id         String   @id @default(uuid())
  name_ar    String
  name_en    String
  slug       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  articles NewsArticle[]
}

model NewsArticle {
  id               String    @id @default(uuid())
  category_id      String?
  title_ar         String
  title_en         String?
  slug             String    @unique
  excerpt_ar       String?
  excerpt_en       String?
  content_ar       String
  content_en       String?
  cover_image_path String?
  status           String    @default("draft")
  is_featured      Boolean   @default(false)
  published_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now()) @updatedAt

  category NewsCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
}

model Notification {
  id          String   @id @default(uuid())
  user_id     String
  type        String
  title       String
  message     String
  entity_type String?
  entity_id   String?
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model AppSetting {
  id                  String   @id @default(uuid())
  user_id             String   @unique
  language            String   @default("ar")
  theme               String   @default("system")
  text_size           String   @default("normal")
  reduced_motion      Boolean  @default(false)
  email_notifications Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  user_id     String?
  action      String
  entity_type String?
  entity_id   String?
  metadata    Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

// LMS / Capacity Building Models

model CourseCategory {
  id          String   @id @default(uuid())
  nameAr      String   @map("name_ar")
  nameEn      String   @map("name_en")
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  courses Course[]
  @@map("course_categories")
}

model CourseTag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  courses CourseTagOnCourse[]
  @@map("course_tags")
}

model CourseTagOnCourse {
  courseId String @map("course_id")
  tagId    String @map("tag_id")

  course Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag    CourseTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
  @@map("course_tag_on_course")
}

model Course {
  id                  String   @id @default(uuid())
  titleAr             String   @map("title_ar")
  titleEn             String?  @map("title_en")
  slug                String   @unique
  shortDescAr         String?  @map("short_desc_ar")
  shortDescEn         String?  @map("short_desc_en")
  fullDescAr          String?  @map("full_desc_ar")
  fullDescEn          String?  @map("full_desc_en")
  thumbnailUrl        String?  @map("thumbnail_url")
  bannerUrl           String?  @map("banner_url")
  instructorName      String   @map("instructor_name")
  instructorBio       String?  @map("instructor_bio")
  instructorAvatar    String?  @map("instructor_avatar")
  categoryId          String?  @map("category_id")
  difficulty          String   @default("beginner")
  duration            Int?
  estimatedStudyTime  Int?     @map("estimated_study_time")
  language            String   @default("ar")
  prerequisites       String?  @map("prerequisites")
  learningObjectives  Json?    @map("learning_objectives")
  archiveTopic        String?  @map("archive_topic")
  region              String?
  historicalPeriod    String?  @map("historical_period")
  targetAudience      String?  @map("target_audience")
  seoTitle            String?  @map("seo_title")
  seoDescription      String?  @map("seo_description")
  seoKeywords         String?  @map("seo_keywords")
  version             String?  @default("1.0")
  status              String   @default("draft")
  visibility          String   @default("public")
  isFeatured          Boolean  @default(false) @map("is_featured")
  isPopular           Boolean  @default(false) @map("is_popular")
  isFree              Boolean  @default(true) @map("is_free")
  publishedAt         DateTime? @map("published_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  category    CourseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lessons        Lesson[]
  lessonProgress LessonProgress[]
  enrollments    CourseEnrollment[]
  tags        CourseTagOnCourse[]
  reviews     CourseReview[]
  savedBy     SavedCourse[]
  achievements Achievement[]
  @@map("courses")
}

model Lesson {
  id                   String   @id @default(uuid())
  courseId             String   @map("course_id")
  lessonNumber         Int      @map("lesson_number")
  titleAr              String   @map("title_ar")
  titleEn              String?  @map("title_en")
  slug                 String
  videoUrl             String?  @map("video_url")
  videoDuration        Int?     @map("video_duration")
  contentAr            String?  @map("content_ar")
  contentEn            String?  @map("content_en")
  summaryAr            String?  @map("summary_ar")
  summaryEn            String?  @map("summary_en")
  transcript           String?
  estimatedReadingTime Int?     @map("estimated_reading_time")
  completionThreshold  Float    @default(0.95) @map("completion_threshold")
  isAssessment         Boolean  @default(false) @map("is_assessment")
  status               String   @default("published")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attachments LessonAttachment[]
  progress    LessonProgress[]
  @@unique([courseId, lessonNumber])
  @@unique([courseId, slug])
  @@map("lessons")
}

model LessonAttachment {
  id        String   @id @default(uuid())
  lessonId  String   @map("lesson_id")
  type      String
  titleAr   String   @map("title_ar")
  titleEn   String?  @map("title_en")
  url       String
  fileSize  Int?     @map("file_size")
  mimeType  String?  @map("mime_type")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@map("lesson_attachments")
}

model CourseEnrollment {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  courseId             String    @map("course_id")
  enrolledAt           DateTime  @default(now()) @map("enrolled_at")
  completedAt          DateTime? @map("completed_at")
  lastActivityAt       DateTime? @map("last_activity_at")
  currentLessonNumber  Int       @default(1) @map("current_lesson_number")
  courseProgress       Float     @default(0) @map("course_progress")
  lessonsCompleted     Int       @default(0) @map("lessons_completed")
  totalWatchTime       Int       @default(0) @map("total_watch_time")
  isCompleted          Boolean   @default(false) @map("is_completed")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  courseId        String    @map("course_id")
  lessonId        String    @map("lesson_id")
  watchedSeconds  Int       @default(0) @map("watched_seconds")
  watchPercentage Float     @default(0) @map("watch_percentage")
  lastPosition    Int       @default(0) @map("last_position")
  totalWatchTime  Int       @default(0) @map("total_watch_time")
  isCompleted     Boolean   @default(false) @map("is_completed")
  completedAt     DateTime? @map("completed_at")
  startedAt       DateTime  @default(now()) @map("started_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Achievement {
  id              String   @id @default(uuid())
  titleAr         String   @map("title_ar")
  titleEn         String?  @map("title_en")
  descriptionAr   String?  @map("description_ar")
  descriptionEn   String?  @map("description_en")
  iconUrl         String?  @map("icon_url")
  badgeColor      String?  @map("badge_color")
  criteriaType    String   @map("criteria_type")
  criteriaValue   Int?     @map("criteria_value")
  courseId        String?  @map("course_id")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  course  Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  users   UserAchievement[]
  @@map("achievements")
}

model UserAchievement {
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  earnedAt      DateTime @default(now()) @map("earned_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model CourseReview {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  courseId   String   @map("course_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_reviews")
}

model SavedCourse {
  userId   String   @map("user_id")
  courseId  String   @map("course_id")
  savedAt  DateTime @default(now()) @map("saved_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("saved_courses")
}

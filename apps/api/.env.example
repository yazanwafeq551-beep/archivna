DATABASE_URL=postgresql://postgres:postgres@localhost:5432/archivna?schema=public
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
STORAGE_DRIVER=cloudinary
UPLOAD_DIRECTORY=./uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MAX_IMAGE_SIZE=20971520
MAX_DOCUMENT_SIZE=104857600
MAX_AUDIO_SIZE=262144000
MAX_VIDEO_SIZE=1073741824
MAX_ZIP_SIZE=262144000
FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development

# Requests per minute per IP: everything, then the credential endpoints
# (login/register/password) which get a much tighter budget.
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

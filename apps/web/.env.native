# The packaged app is served from its own local origin, so there is no dev
# proxy and no same-domain API. Both of these must be absolute.
VITE_API_URL=https://archivna-api.onrender.com

# Links meant for other people - certificate verification, share buttons - have
# to point at the public site, never at capacitor://localhost.
VITE_PUBLIC_WEB_URL=https://archivna.vercel.app
